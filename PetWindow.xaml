<Window x:Class="holey.PetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:holey"
        mc:Ignorable="d"
        Title="PetWindow" Height="60" Width="120" Background="Transparent"
        WindowStyle="None" ShowInTaskbar="False" ShowActivated="False"
        AllowsTransparency="True" Loaded="FormLoaded" Topmost="True"
        PreviewMouseMove="PetWindow_OnPreviewMouseMove">
    <Grid>
        <!-- <local:GifImage Source="../Img/giphy.gif" Stretch="Uniform" Cursor="Hand"/> -->
        <Viewbox>
            <Grid  >
                <Grid.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="窗口" Click="ShowItem_OnClick"></MenuItem>
                        <MenuItem Header="关闭" Click="CloseItem_OnClick"></MenuItem>
                        <MenuItem Header="退出" Click="ExitItem_OnClick"></MenuItem>
                    </ContextMenu>
                </Grid.ContextMenu>
                <Border HorizontalAlignment="Stretch" VerticalAlignment="Stretch" CornerRadius="10,10,10,10"  >
                    <Border.Effect>
                        <BlurEffect Radius="20" RenderingBias="Performance"></BlurEffect>
                    </Border.Effect>
                </Border>
                
                <Button  Name="MainStr"   MouseDoubleClick="Control_OnMouseDoubleClick"  Width="120" Height="50" VerticalContentAlignment="Bottom"
                            HorizontalAlignment="Left" VerticalAlignment="Bottom" 
                            Background="Transparent" Foreground="Chocolate"  FontWeight="Bold"
                            Margin="0,10,0,0" Padding="0" IsHitTestVisible="False"
                             Style="{StaticResource NoneButton}"  Cursor="Hand">初始化</Button>
                
                <Grid >
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="20"/>
                    </Grid.ColumnDefinitions>
                    <Rectangle Name="CpuRect"   Grid.Column="0" Grid.ColumnSpan="2" Stroke="Transparent"  Height="10"  Width="100" Cursor="Hand" ToolTip="speed" HorizontalAlignment="Left" VerticalAlignment="Top"  >
                        <Rectangle.Fill>
                            <LinearGradientBrush>
                                <LinearGradientBrush.RelativeTransform>
                                    <TransformGroup>
                                        <RotateTransform Angle="0" CenterX="1" CenterY="1" />
                                        <TranslateTransform />
                                    </TransformGroup>

                                </LinearGradientBrush.RelativeTransform>

                                <GradientStop Color="#44f0a08f" Offset="0" />
                                <GradientStop Color="#66f0a08f" Offset="0.2" />
                                <GradientStop Color="#aaf0a08f" Offset="0.66" />
                                <GradientStop Color="#ccf0a08f" Offset="1" />
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>
                    <Button   MouseDoubleClick="Control_OnMouseDoubleClick"  Height="10"  Width="10" 
                            HorizontalAlignment="Right" VerticalAlignment="Top"  Grid.Column="1" 
                            Background="Transparent" Foreground="Chocolate"  FontWeight="Bold"
                            
                             Style="{StaticResource NoneButton}"  Cursor="Hand"  
                            
                    >
                        <Rectangle Name="CpuRectEnd"   Grid.Column="1"  Stroke="Transparent"  Height="10"  Width="10" Cursor="Hand" 
                                ToolTip="speed" HorizontalAlignment="Right" VerticalAlignment="Top"  >
                            <Rectangle.Fill>
                                <LinearGradientBrush>

                                    <LinearGradientBrush.RelativeTransform>
                                        <TransformGroup>
                                            <RotateTransform Angle="-10" CenterX="1" CenterY="1" />
                                            <TranslateTransform />
                                        </TransformGroup>

                                    </LinearGradientBrush.RelativeTransform>



                                    <GradientStop Color="#ffff0000" Offset="0" />
                                    <GradientStop Color="#ffff0000" Offset="0.1" />
                                    <GradientStop Color="#a0f00000" Offset="0.2" />
                                    <GradientStop Color="#a0f00000" Offset="0.5" />
                                    <GradientStop Color="#88ff0000" Offset="0.5" />
                                    <GradientStop Color="#99ff0000" Offset="0.9" />
                                    <GradientStop Color="#99ff00ff" Offset="1" />
                                </LinearGradientBrush>
                            </Rectangle.Fill>
                        </Rectangle>
                    </Button>

                    
                    <Button x:Name="MemBtn"  MouseDoubleClick="Control_OnMouseDoubleClick"  Width="10" Height="50"
                            HorizontalAlignment="Right" VerticalAlignment="Bottom"  Grid.Column="2" 
                            Background="Transparent" Foreground="Chocolate"  FontWeight="Bold"
                            Margin="0,0,0,5"
                             Style="{StaticResource NoneButton}"  Cursor="Hand">
                        <Grid>
                            <Viewbox>
                                <TextBlock x:Name="MemStr"  FontSize="12" Width="10" TextWrapping="Wrap" Foreground="Black">100%</TextBlock>
                            </Viewbox>
                            
                            <Rectangle   Stroke="Transparent"  Height="50"  Width="10" Cursor="Hand" 
                                 HorizontalAlignment="Right" VerticalAlignment="Bottom"  >
                                <Rectangle.Fill>
                                    <LinearGradientBrush>
                                        <LinearGradientBrush.RelativeTransform>
                                            <TransformGroup>
                                                <RotateTransform Angle="200" CenterX="0.5" CenterY="0.5" />
                                                <TranslateTransform />
                                            </TransformGroup>
                                        </LinearGradientBrush.RelativeTransform>
                                        <GradientStop Color="#33FF6900" Offset="0" />
                                        <GradientStop Color="#44FF6900" Offset="0.2" />
                                        <GradientStop Color="#55FF6900" Offset="0.3" />
                                        <GradientStop Color="#66FF6900" Offset="0.5" />
                                        <GradientStop Color="#99FF6900" Offset="0.7" />
                                        <GradientStop Color="#bbFF6900" Offset="0.9" />
                                        <GradientStop Color="#ffFF6900" Offset="1" />
                                    </LinearGradientBrush>
                                </Rectangle.Fill>
                            </Rectangle>
                        </Grid>
                     
                    </Button>
                    

                    <Ellipse Grid.Column="2" Stroke="Transparent" Width="15" Height="15" Cursor="Hand" HorizontalAlignment="Right" Visibility="Collapsed" VerticalAlignment="Top"  >
                            <Ellipse.Fill>
                                <RadialGradientBrush GradientOrigin="0.2,0.8" RadiusX="0.75" RadiusY="0.75">
                                    <RadialGradientBrush.RelativeTransform>
                                        <TransformGroup>
                                            <RotateTransform Angle="90" CenterX="0.5" CenterY="0.5" />
                                            <TranslateTransform />
                                        </TransformGroup>
                                    </RadialGradientBrush.RelativeTransform>
                                    <GradientStop Color="#33FFFFFF" Offset="0" />
                                    <GradientStop Color="#AA312dea" Offset="0.66" />
                                    <GradientStop Color="#FF1a15ff" Offset="1" />
                                </RadialGradientBrush>
                            </Ellipse.Fill>
                        </Ellipse>

                  
                   
                </Grid>
                
             


               
              

            </Grid>

        </Viewbox>

        <!-- Viewport3D is the rendering surface. -->

    </Grid>
</Window>