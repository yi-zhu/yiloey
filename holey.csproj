<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <CETCompat>false</CETCompat><!-- 禁用CET，win10 不支持CET，只有win11支持-->
        <OutputType>WinExe</OutputType>
        <Nullable>enable</Nullable>
        <UseWPF>true</UseWPF>
        <ApplicationIcon>ico.ico</ApplicationIcon>
        <GenerateDocumentationFile>false</GenerateDocumentationFile>
<!--        <DebugType>None</DebugType>-->
        <Copyright>yi</Copyright>
        <LangVersion>latest</LangVersion>
        <TargetFramework>net462</TargetFramework>
        <PackageIcon>ico.png</PackageIcon>
        <Version>2.9</Version>
        <Product>YTunnel</Product>
        <Title>YTunnel</Title>
        <AssemblyName>ytloey</AssemblyName>
        <Authors>yizhu</Authors>
        <Description>yizhu.space</Description>
        <PackageProjectUrl>yizhu.space</PackageProjectUrl>
        <PackageLicenseUrl>yizhu.space</PackageLicenseUrl>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <ImplicitUsings>disable</ImplicitUsings>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
        <Optimize>True</Optimize>
        <CETCompat>false</CETCompat><!-- 禁用CET，win10 不支持CET，只有win11支持-->
    </PropertyGroup>

    <ItemGroup>

        <None Remove="Img\*.png"/>
        <None Remove="Img\*.gif"/>
        <None Remove="Img\*.psd"/>
        <Resource Include="Img\*.png">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Resource>
        <Resource Include="Img\*.jpg">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Resource>
        <!-- <Resource Include="Img\*.gif">
           <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
         </Resource>-->
        <None Remove="drv\*\*"/>
        <Content Include="drv\*\*">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>
        <Content Include="drv\*">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>
        <Content Include="Binaries\*">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>

        <None Remove="eyi.exe"/>
        <Content Include="eyi.exe">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>
        <None Remove="ey.exe"/>
        <Content Include="ey.exe">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>
        <None Update="ico.png">
            <Pack>True</Pack>
            <PackagePath></PackagePath>
        </None>
        <None Update="Tools\RAMMap.exe">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
        <None Update="Tools\poolmon.exe">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
   
        <Page Remove="Vdd\Languages\zh.xaml" />
        <Resource Include="Vdd\Languages\zh.xaml">
          <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Resource>
        <Page Update="WebView\YiWebView.xaml">
          <Generator>MSBuild:Compile</Generator>
          <XamlRuntime>Wpf</XamlRuntime>
          <SubType>Designer</SubType>
        </Page>

    </ItemGroup>

    <ItemGroup>
        <Compile Update="Properties\Settings.Designer.cs">
            <DesignTimeSharedInput>True</DesignTimeSharedInput>
            <AutoGen>True</AutoGen>
            <DependentUpon>Settings.settings</DependentUpon>
        </Compile>
    </ItemGroup>

    <ItemGroup>
        <None Update="Properties\Settings.settings">
            <Generator>SettingsSingleFileGenerator</Generator>
            <LastGenOutput>Settings.Designer.cs</LastGenOutput>
        </None>
    </ItemGroup>


    <ItemGroup>
        <Resource Update="Img\btncolor.png">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </Resource>

    </ItemGroup>

    <ItemGroup>
        <EditorConfigFiles Remove=".editorconfig"/>
    </ItemGroup>

    <ItemGroup>
        <None Include=".editorconfig"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3530-prerelease" />
        <PackageReference Include="Microsoft.Xaml.Behaviors.Wpf" Version="1.1.39"/>
        <PackageReference Include="NAudio" Version="1.8.5"/>
        <PackageReference Include="Obfuscar" Version="2.2.38">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="System.Text.Json" Version="10.0.0-rc.1.25451.107" />
        <PackageReference Include="Tesseract" Version="5.2.0" />
    </ItemGroup>

    <ItemGroup>
        <Folder Include="Remote"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\YiKits\YiKits.csproj">
            <ReferenceOutputAssembly>true</ReferenceOutputAssembly>
            <Private>True</Private>
            <CopyLocalSatelliteAssemblies>True</CopyLocalSatelliteAssemblies>
        </ProjectReference>
    </ItemGroup>

    <ItemGroup>
        <COMReference Include="ShockwaveFlashObjects">
            <Guid>{D27CDB6B-AE6D-11CF-96B8-444553540000}</Guid>
            <VersionMajor>1</VersionMajor>
            <VersionMinor>0</VersionMinor>
            <Lcid>0</Lcid>
            <WrapperTool>tlbimp</WrapperTool>
            <Isolated>False</Isolated>
            <EmbedInteropTypes>True</EmbedInteropTypes>
        </COMReference>
    </ItemGroup>

    <ItemGroup>
        <Reference Include="Microsoft.CSharp">
          <HintPath>C:\Windows\Microsoft.NET\assembly\GAC_MSIL\Microsoft.CSharp\v4.0_4.0.0.0__b03f5f7f11d50a3a\Microsoft.CSharp.dll</HintPath>
        </Reference>
        <Reference Include="System.Configuration.Install"/>
        <Reference Include="System.IO.Compression"/>
        <Reference Include="System.Management"/>
        <Reference Include="System.Net.Http"/>
        <Reference Include="System.ServiceProcess"/>
        <Reference Include="System.Windows.Forms"/>
        <Reference Include="Windows.UI.Xaml">
          <HintPath>C:\WINDOWS\system32\WinMetadata\Windows.UI.Xaml.winmd</HintPath>
        </Reference>
        <Reference Include="WindowsFormsIntegration"/>
    </ItemGroup>

    <ItemGroup>
        <Page Update="Crosshair.xaml">
            <Generator>MSBuild:Compile</Generator>
            <XamlRuntime>Wpf</XamlRuntime>
            <SubType>Designer</SubType>
        </Page>
    </ItemGroup>

</Project>
