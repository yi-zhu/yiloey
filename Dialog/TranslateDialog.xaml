<Window x:Class="holey.Dialog.TranslateDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:holey.Dialog"
        mc:Ignorable="d" Background="Transparent"
          WindowStyle="None" ShowInTaskbar="False" ShowActivated="False"
        AllowsTransparency="True" Loaded="FormLoaded" Topmost="True"
     
        Title="TranslateDialog" Height="300" Width="400">
    <Grid  Name="LayoutRoot" MouseLeave="LayoutRoot_OnMouseLeave" MouseEnter="LayoutRoot_OnMouseEnter">
        <Grid.RowDefinitions>
            <RowDefinition Height="1.2*"></RowDefinition>
            <RowDefinition Height="20"></RowDefinition>
            <RowDefinition Height="1*"></RowDefinition>
        </Grid.RowDefinitions>

        <TextBox Grid.Row="0" Name="ZhTx"  BorderThickness="0"
                 Background="#66000000"
                 HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" 
                 KeyDown="ZhTx_OnKeyDown" TextWrapping="Wrap"></TextBox>
        
        
        <Grid Grid.Row="1" OpacityMask="#FF921E1E" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" 
              Background="#66ffffff">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"></ColumnDefinition>
                <ColumnDefinition Width="20"></ColumnDefinition>
            </Grid.ColumnDefinitions>
            <TextBlock Text="翻译默认上下,回车即可翻译" FontSize="14" FontFamily="Microsoft YaHei UI" 
                       MouseLeave="UIElement_OnMouseLeave" MouseEnter="UIElement_OnMouseEnter"
                       PreviewMouseMove="PetWindow_OnPreviewMouseMove"></TextBlock>
            <Button Name="Close" Style="{StaticResource NoneButton}" Grid.Column="1" Content="❌" 
                    MouseEnter="Close_OnMouseEnter"
                    MouseLeave="Close_OnMouseLeave"
                    Click="ButtonBase_OnClick"></Button>
        </Grid>
        
        
        <TextBox Grid.Row="2" Name="EnTx" 
                 Background="#55000000" BorderThickness="0"
                 HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" 
                 KeyDown="EnTx_OnKeyDown" TextWrapping="Wrap"></TextBox>
    </Grid>
</Window>
