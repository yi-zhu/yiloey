<Window x:Class="holey.Dialog.UcConvertDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        mc:Ignorable="d"
        Title="uc转换" Height="560" Width="680" WindowStartupLocation="CenterScreen">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,2">
            <TextBlock Text="源文件夹：" VerticalAlignment="Center" />
            <Button DockPanel.Dock="Right" Content="浏览..." Width="70" Margin="4,0,0,0" Click="BrowseSrc_OnClick" />
            <TextBox Name="SrcBox" ToolTip="存放 .uc 缓存文件的文件夹（播放中被占用的文件会自动跳过）" />
        </DockPanel>

        <DockPanel Grid.Row="1" Margin="0,4">
            <TextBlock Text="输出文件夹：" VerticalAlignment="Center" />
            <Button DockPanel.Dock="Right" Content="浏览..." Width="70" Margin="4,0,0,0" Click="BrowseOut_OnClick" />
            <TextBox Name="OutBox" ToolTip="留空则默认为 源文件夹\uc_out" />
        </DockPanel>
        <DockPanel Grid.Row="2" Margin="0,4">
            <TextBlock Text="输出文件夹2：" VerticalAlignment="Center" />
            <Button DockPanel.Dock="Right" Content="浏览..." Width="70" Margin="4,0,0,0" Click="BrowseOut1_OnClick" />
            <TextBox Name="OutBox1" ToolTip="可同时复制到.适用于移动硬盘或U盘等目录" />
        </DockPanel>

        <WrapPanel Grid.Row="3" Margin="0,4">
            <TextBlock Text="扩展名：" VerticalAlignment="Center" />
            <TextBox Name="ExtBox" Text="uc" Width="60" Margin="0,0,12,0" ToolTip="待转换文件的扩展名，默认 uc" />
            <CheckBox Name="SubDirCheck" Content="包含子目录" IsChecked="True" VerticalAlignment="Center"
                      Foreground="Black" ToolTip="递归处理源文件夹下的所有子文件夹" />
            <CheckBox Name="ApiCheck" Content="联网获取歌曲信息" IsChecked="True" VerticalAlignment="Center" Margin="12,0,0,0"
                      Foreground="Black"
                      ToolTip="参考 CloudMusicDownloader：按文件名开头的歌曲ID查网易云 api/song/detail，补齐 歌手/歌名/专辑/年份（需联网，离线时自动跳过）" />
            <CheckBox Name="MetaCheck" Content="json边车优先" IsChecked="True" VerticalAlignment="Center" Margin="12,0,0,0"
                      Foreground="Black"
                      ToolTip="存在同名 {文件名}.json（字段 artist/title/album/genre/track）时优先用边车，否则用联网查询结果" />
            <CheckBox Name="RenameCheck" Content="按信息重命名输出" IsChecked="True" VerticalAlignment="Center" Margin="12,0,0,0"
                      Foreground="Black"
                      ToolTip="拿到歌曲信息后，输出文件命名为 歌手 - 标题.扩展名（是否重名由下方策略处理）；取消勾选则保留原文件名" />
            <TextBlock Text="目标已存在：" VerticalAlignment="Center" Margin="12,0,0,0" />
            <ComboBox Name="ConflictBox" Width="120" SelectedIndex="0" VerticalAlignment="Center" Foreground="Black"
                      ToolTip="输出文件夹里已有同名文件时：跳过=保留旧文件不转换；覆盖=用新文件替换；加标记防重复=另存为 名称 (1)、(2) …">
                <ComboBoxItem Content="跳过" Tag="Skip" />
                <ComboBoxItem Content="覆盖" Tag="Overwrite" />
                <ComboBoxItem Content="加标记防重复" Tag="Mark" />
            </ComboBox>
        </WrapPanel>

        <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,4">
            <Button Name="RunBtn" Content="开始转换" Width="100" Click="Run_OnClick"
                    ToolTip="XOR-0xA3 解密网易云 .uc 缓存；存在同名 .json 边车时用 ffmpeg 无损回填 ID3 并按 歌手 - 标题 命名" />
        </StackPanel>

        <GroupBox Grid.Row="5" Header="自动监听（左键 uc转换 开关）" Margin="0,6,0,0" Padding="6,4">
            <StackPanel>
                <WrapPanel>
                    <CheckBox Name="ToastCheck" Content="显示转换提示" IsChecked="True" VerticalAlignment="Center"
                              Foreground="Black" />
                    <TextBlock Text="位置：" VerticalAlignment="Center" Margin="12,0,0,0" />
                    <ComboBox Name="ToastPosBox" Width="92" SelectedIndex="0" VerticalAlignment="Center" Foreground="Black">
                        <ComboBoxItem Content="屏幕中央" />
                        <ComboBoxItem Content="左上角" />
                        <ComboBoxItem Content="右上角" />
                        <ComboBoxItem Content="左下角" />
                        <ComboBoxItem Content="右下角" />
                    </ComboBox>
                    <TextBlock Text="扫描时间：" VerticalAlignment="Center" Margin="16,0,0,0" />
                    <TextBox Name="ScanBox" Width="46" Text="2" VerticalAlignment="Center"
                             ToolTip="文件最后一次写入后静默多少秒开始转换；越小越快，太大不会影响，太小可能转到未写完的文件" />
                    <TextBlock Text="秒（停止写入后等待）" VerticalAlignment="Center" Margin="4,0,0,0" />
                </WrapPanel>
                <WrapPanel Margin="0,8,0,0">
                    <CheckBox Name="ClickCheck" Content="转换完成后点击坐标" VerticalAlignment="Center"
                              Foreground="Black" />
                    <TextBlock Text="X" VerticalAlignment="Center" Margin="10,0,4,0" />
                    <TextBox Name="ClickXBox" Width="56" VerticalAlignment="Center" />
                    <TextBlock Text="Y" VerticalAlignment="Center" Margin="8,0,4,0" />
                    <TextBox Name="ClickYBox" Width="56" VerticalAlignment="Center" />
                    <Button Name="PickPosBtn" Content="取当前位置" Width="84" Margin="8,0,0,0" Click="PickPos_OnClick"
                            ToolTip="点击后 3 秒读取鼠标位置，期间把鼠标移到目标位置" />
                </WrapPanel>
                <WrapPanel Margin="0,8,0,0">
                    <CheckBox Name="KeysCheck" Content="转换完成后发送按键" VerticalAlignment="Center"
                              Foreground="Black" />
                    <TextBox Name="KeysBox" Width="160" Margin="10,0,0,0" VerticalAlignment="Center"
                             ToolTip="SendKeys 语法，例如 {ENTER}、{TAB}、^v 表示 Ctrl+V；留空则不发送" />
                    <TextBlock Text="SendKeys 语法，如 {ENTER}" VerticalAlignment="Center" Margin="8,0,0,0"
                               Foreground="Gray" />
                </WrapPanel>
            </StackPanel>
        </GroupBox>

        <TextBlock Grid.Row="6" Name="StatusText" Margin="0,4" Text="就绪" TextWrapping="Wrap" />

        <StackPanel Grid.Row="7" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="关闭" Width="80" Click="Close_OnClick" />
        </StackPanel>
    </Grid>
</Window>
