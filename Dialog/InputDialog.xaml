<Window x:Class="holey.Dialog.InputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:holey.Dialog"
        mc:Ignorable="d"
        Title="交互式对话框" Height="200" Width="400">
    <Grid>
        
        <Grid.RowDefinitions>
            <RowDefinition Height="5" />
            <RowDefinition Height="*" />
            <RowDefinition Height="5" />
            <RowDefinition Height="50" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="1" VerticalAlignment="Center" Name="DialogContent">

            <DockPanel>
                <TextBlock Name="Label">名称</TextBlock>
                <TextBox Name="TextBox" ToolTip="输入内容确定即可获得内容" Focusable="True"></TextBox>
            </DockPanel>

       
        </StackPanel>

        <Grid Grid.Row="3" Grid.Column="0" >
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="10"/>
            </Grid.ColumnDefinitions>
            
            <Button Grid.Column="1" Name="Ok" Content="确定" Click="Ok_OnClick" IsDefault="True"></Button>
            <Button Grid.Column="3" Name="Close" Content="取消" Click="Close_OnClick"  >
            </Button>

        </Grid>
    </Grid>
</Window>
