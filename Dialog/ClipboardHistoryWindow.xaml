<Window x:Class="holey.Dialog.ClipboardHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="剪切板历史" Height="450" Width="600"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded" Closing="Window_Closing">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- 工具栏 -->
        <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="10,10,10,0">
            <Button    Content="清空历史" Click="ClearHistory_Click" Margin="0,0,10,0"/>
          
            <Button  Style="{StaticResource NoChromeButton}" Content="复制所有" Click="CopyAll_Click" Margin="0,0,10,0"/>
            
            <CheckBox Content="自动保存" Foreground="Black" x:Name="AutoSaveCheckBox" Checked="AutoSaveCheckBox_Checked" Unchecked="AutoSaveCheckBox_Unchecked"/>
            <Button  Style="{StaticResource NoChromeButton}" Content="保存到文件" Click="SaveToFile_Click" Margin="0,0,10,0"/>
            <TextBlock Text="长度：" VerticalAlignment="Center" Margin="0,0,5,0"/>
            <TextBox x:Name="LengthTextBox" Width="50" Margin="0,0,10,0" TextChanged="LengthTextBox_TextChanged" ToolTip="按最小长度筛选"/>
            <TextBlock Text="筛选：" VerticalAlignment="Center" Margin="0,0,5,0"/>
            <TextBox x:Name="FilterTextBox" Width="100" Margin="0,0,10,0" TextChanged="FilterTextBox_TextChanged" ToolTip="按包含内容筛选"/>
            
        </StackPanel>
        
        <!-- 筛选选项 -->
        <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="10,40,10,0">

        </StackPanel>
        
        <!-- 历史记录列表 -->
        <ListBox x:Name="ClipboardHistoryList" Grid.Row="1" Margin="10" SelectionMode="Single">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Vertical">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Content}" TextWrapping="Wrap" FontWeight="Bold" Width="450"/>
                            <Button Content="复制" Click="CopyItem_Click" Tag="{Binding Content}" Margin="10,0,0,0"/>
                        </StackPanel>
                        <TextBlock Text="{Binding Time}" FontSize="10" Foreground="Gray"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        
        <!-- 状态栏 -->
        <Grid Grid.Row="2" Margin="10,0,10,10">
            <!-- 定义两列，第一列自适应内容，第二列占据剩余空间 -->
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 左侧文本 -->
            <TextBlock x:Name="StatusNum" Text="0" Grid.Column="0"/>
    
            <!-- 右侧文本，放在第二列，并设置靠右对齐 -->
            <TextBlock x:Name="StatusText" Text="就绪" Grid.Column="1" HorizontalAlignment="Right"/>
        </Grid>
 
    </Grid>
</Window>