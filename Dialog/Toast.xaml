<Window x:Class="holey.Dialog.Toast"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:holey.Dialog"
             WindowStyle="None"
             mc:Ignorable="d"
              AllowsTransparency="True"
             Background="Transparent"
            >
    <Grid x:Name="LayoutRoot" Background="Transparent" 
          MouseDown="LayoutRoot_OnMouseDown" MouseLeave="LayoutRoot_OnMouseLeave" MouseEnter="LayoutRoot_OnMouseEnter" 
          
          >
        <Border CornerRadius="5" Background="#90000000" Padding="10" >
            <TextBlock x:Name="tbMessage" Text="Hello, World!" Foreground="White" FontSize="14" FontWeight="Bold" Margin="5" />
        </Border>
    </Grid>
</Window>
