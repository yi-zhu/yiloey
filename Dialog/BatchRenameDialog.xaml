<Window x:Class="holey.Dialog.BatchRenameDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:holey.Dialog"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        mc:Ignorable="d"
        Title="批量命名" Height="600" Width="900" WindowStartupLocation="CenterScreen">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,2">
            <TextBlock Text="文件夹：" VerticalAlignment="Center" />
            <Button DockPanel.Dock="Right" Name="BrowseBtn" Content="浏览..." Width="70" Margin="4,0,0,0"
                    Click="Browse_OnClick" />
            <TextBox Name="FolderBox" ToolTip="要批量重命名的媒体文件所在文件夹" />
        </DockPanel>

        <WrapPanel Grid.Row="1" Margin="0,4">
            <TextBlock Text="扩展名：" VerticalAlignment="Center" />
            <TextBox Name="ExtBox" Text="mp3" Width="60" Margin="0,0,12,0" ToolTip="媒体文件扩展名，如 mp3" />
            <TextBlock Text="命名格式：" VerticalAlignment="Center" />
            <TextBox Name="FormatBox" Text="{}{歌手}-{歌曲}-{流派}.{后缀}" Width="240" Margin="0,0,8,0"
                     TextChanged="FormatBox_OnTextChanged"
                     ToolTip="{}支持令牌: {歌手} {歌曲} {流派} {专辑} {原文件名} {后缀} {序号} {目录}；{序号:2}=补零两位；也支持英文 {artist} {title} {genre} {album} {name} {ext} {n}" />
            <Menu Name="PresetMenu" Background="Transparent" VerticalAlignment="Center" Margin="0,0,12,0">
                <MenuItem Header="常用格式" ToolTip="点选一个音乐命名预设填入格式框">
                    <MenuItem Header="{}{歌手}-{歌曲}-{流派}.{后缀}  （默认）" Click="Preset_OnClick" />
                    <MenuItem Header="{}{序号:2}-{歌手}-{歌曲}.{后缀}" Click="Preset_OnClick" />
                    <MenuItem Header="{}{歌手}-{专辑}-{序号:2}-{歌曲}.{后缀}  （按专辑曲目）" Click="Preset_OnClick" />
                    <MenuItem Header="{}{目录}-{歌曲}.{后缀}  （目录名当歌手）" Click="Preset_OnClick" />
                    <MenuItem Header="{}{歌曲}.{后缀}  （仅歌名）" Click="Preset_OnClick" />
                    <MenuItem Header="{}{歌手} - {歌曲}.{后缀}  （空格分隔）" Click="Preset_OnClick" />
                    <MenuItem Header="{}{序号:2}.{歌手}-{歌曲}.{后缀}" Click="Preset_OnClick" />
                    <MenuItem Header="{}{原文件名}.{后缀}  （还原原名）" Click="Preset_OnClick" />
                </MenuItem>
            </Menu>
            <TextBlock Text="起始序号：" VerticalAlignment="Center" ToolTip="{}{序号} 令牌从该数字开始递增" />
            <TextBox Name="StartBox" Text="1" Width="40" Margin="0,0,12,0" ToolTip="{}{序号} 令牌从该数字开始递增" />
            <CheckBox Name="SubDirCheck" Content="包含子目录" IsChecked="True" VerticalAlignment="Center" Margin="0,0,12,0"
                      Foreground="Black" ToolTip="读取时递归处理所选文件夹下的所有子文件夹" />
            <CheckBox Name="GenreDirCheck" Content="目录名推断流派" IsChecked="True" VerticalAlignment="Center"
                      Foreground="Black" ToolTip="文件缺少流派标签时，从所在目录名中识别流行/摇滚/Jazz 等关键词作为流派" />
        </WrapPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,4">
            <Button Name="ScanBtn" Content="读取文件" Width="90" Margin="0,0,8,0" Click="Scan_OnClick" />
            <Button Name="ApplyBtn" Content="应用重命名" Width="100" Margin="0,0,8,0" Click="Apply_OnClick"
                    IsEnabled="False" ToolTip="按当前格式与表格中编辑的字段重命名文件" />
            <TextBlock Name="TipText" VerticalAlignment="Center" Foreground="Gray"
                       Text="可直接编辑 歌手/歌曲/流派 列，新文件名实时预览；重名自动追加序号" />
        </StackPanel>

        <DataGrid Grid.Row="4" Name="Grid" Margin="0,4" AutoGenerateColumns="False"
                  CanUserAddRows="False" HeadersVisibility="Column" SelectionMode="Extended">
            <DataGrid.Columns>
                <DataGridTextColumn Header="目录" Binding="{Binding Folder}" IsReadOnly="True" Width="170" />
                <DataGridTextColumn Header="原文件名" Binding="{Binding FileName}" IsReadOnly="True" Width="180" />
                <DataGridTextColumn Header="歌手" Width="110"
                                    Binding="{Binding Artist, UpdateSourceTrigger=PropertyChanged}" />
                <DataGridTextColumn Header="歌曲" Width="140"
                                    Binding="{Binding Title, UpdateSourceTrigger=PropertyChanged}" />
                <DataGridTextColumn Header="流派" Width="90"
                                    Binding="{Binding Genre, UpdateSourceTrigger=PropertyChanged}" />
                <DataGridTextColumn Header="新文件名" Binding="{Binding NewName}" IsReadOnly="True" Width="*" />
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock Grid.Row="5" Name="StatusText" Margin="0,4" Text="未读取" />

        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="关闭" Width="80" Click="Close_OnClick" />
        </StackPanel>
    </Grid>
</Window>
