<Window x:Class="holey.Dialog.PortCheckDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="端口工具"
        Height="640" Width="720"
        MinHeight="480" MinWidth="560"
        WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI"
        Background="#F7F7F8"
        Foreground="#1A1A1A"
        Closing="Window_Closing">
    <Window.Resources>
        <Style x:Key="ActionBtn" TargetType="Button">
            <Setter Property="Padding" Value="14,6" />
            <Setter Property="Margin" Value="6,0,0,0" />
            <Setter Property="MinWidth" Value="76" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#D8DADF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#EEF1F5" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PrimaryBtn" TargetType="Button">
            <Setter Property="Padding" Value="14,6" />
            <Setter Property="Margin" Value="6,0,0,0" />
            <Setter Property="MinWidth" Value="76" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="#2563EB" CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1D4ED8" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Foreground" Value="#5F6368" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style x:Key="FieldBox" TargetType="TextBox">
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="BorderBrush" Value="#D8DADF" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TabControl x:Name="MainTabs" Grid.Row="0" Background="Transparent" BorderThickness="0">
            <!-- 扫描 -->
            <TabItem Header="端口扫描">
                <Grid Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="White" BorderBrush="#D8DADF" BorderThickness="1"
                            CornerRadius="8" Padding="12" Margin="0,0,0,10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <DockPanel Grid.Row="0" Margin="0,0,0,8">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="主机" Width="56"
                                           ToolTip="支持 IP/域名、逗号分隔、CIDR(/24)、IP 段(1-10)" />
                                <TextBox x:Name="HostsBox" Style="{StaticResource FieldBox}"
                                         Text="127.0.0.1"
                                         ToolTip="例: 127.0.0.1, 192.168.0.1/24, 192.168.0.1-20" />
                            </DockPanel>

                            <DockPanel Grid.Row="1" Margin="0,0,0,8">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="端口" Width="56"
                                           ToolTip="支持 80,443,8000-8010" />
                                <TextBox x:Name="PortsBox" Style="{StaticResource FieldBox}"
                                         Text="80,443,8080"
                                         ToolTip="例: 80,443,22,3389 或 1-1024" />
                            </DockPanel>

                            <WrapPanel Grid.Row="2" Margin="0,0,0,8">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="端口预设" />
                                <ComboBox x:Name="PresetBox" Width="160" Height="28" SelectedIndex="0"
                                          SelectionChanged="PresetBox_OnSelectionChanged">
                                    <ComboBoxItem Content="自定义" Tag="" />
                                    <ComboBoxItem Content="常用 Web" Tag="80,443,8080,8443,8000,8888" />
                                    <ComboBoxItem Content="远程管理" Tag="22,23,3389,5900,5901" />
                                    <ComboBoxItem Content="数据库" Tag="1433,1521,3306,5432,6379,27017" />
                                    <ComboBoxItem Content="开发常用" Tag="3000,4200,5000,5173,8000,8080,9000" />
                                    <ComboBoxItem Content="Windows 服务" Tag="135,139,445,3389,5985,5986" />
                                    <ComboBoxItem Content="1-1024" Tag="1-1024" />
                                </ComboBox>

                                <TextBlock Style="{StaticResource FieldLabel}" Text="线程" Margin="16,0,8,0" />
                                <TextBox x:Name="ThreadBox" Style="{StaticResource FieldBox}" Width="64" Text="100"
                                         ToolTip="并发连接数，建议 50-200" />

                                <TextBlock Style="{StaticResource FieldLabel}" Text="超时(ms)" Margin="16,0,8,0" />
                                <TextBox x:Name="TimeoutBox" Style="{StaticResource FieldBox}" Width="72" Text="1500"
                                         ToolTip="单次 TCP 连接超时毫秒，过小易漏报，过大更慢" />

                                <TextBlock Style="{StaticResource FieldLabel}" Text="上限" Margin="16,0,8,0" />
                                <TextBox x:Name="MaxItemsBox" Style="{StaticResource FieldBox}" Width="72" Text="20000"
                                         ToolTip="主机×端口 最大检查项，防止过大扫描" />
                            </WrapPanel>

                            <WrapPanel Grid.Row="3" Margin="0,0,0,4">
                                <CheckBox x:Name="OnlyOpenCheck" Content="仅记录开放端口" IsChecked="True"
                                          VerticalAlignment="Center" Margin="0,0,16,0" Foreground="#1A1A1A"
                                          ToolTip="关闭后也会在日志区显示关闭的端口（列表仍只显示开放）" />
                                <CheckBox x:Name="AutoScrollCheck" Content="自动滚动" IsChecked="True"
                                          VerticalAlignment="Center" Margin="0,0,16,0" Foreground="#1A1A1A" />
                                <CheckBox x:Name="SaveSettingsCheck" Content="记住设置" IsChecked="True"
                                          VerticalAlignment="Center" Foreground="#1A1A1A" />
                            </WrapPanel>

                            <DockPanel Grid.Row="4" Margin="0,6,0,0">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <Button x:Name="StartBtn" Style="{StaticResource PrimaryBtn}" Content="开始扫描"
                                            Margin="0" Click="Start_OnClick" />
                                    <Button x:Name="StopBtn" Style="{StaticResource ActionBtn}" Content="停止"
                                            IsEnabled="False" Click="Stop_OnClick" />
                                    <Button Style="{StaticResource ActionBtn}" Content="清空"
                                            Click="Clear_OnClick" />
                                    <Button x:Name="CopyBtn" Style="{StaticResource ActionBtn}" Content="复制"
                                            Click="Copy_OnClick" />
                                    <Button Style="{StaticResource ActionBtn}" Content="导出"
                                            Click="Export_OnClick" />
                                </StackPanel>
                                <TextBlock x:Name="EstimateText" VerticalAlignment="Center"
                                           Foreground="#5F6368" FontSize="12"
                                           Text="填写主机与端口后开始扫描" TextWrapping="Wrap" />
                            </DockPanel>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="1" Margin="0,0,0,8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <ProgressBar x:Name="Progress" Grid.Row="0" Height="10" Minimum="0" Maximum="100" Value="0" />
                        <DockPanel Grid.Row="1" Margin="0,6,0,0">
                            <TextBlock DockPanel.Dock="Left" Text="开放端口" FontWeight="SemiBold" />
                            <TextBlock x:Name="OpenCountText" DockPanel.Dock="Right" Text="0"
                                       Foreground="#2563EB" FontWeight="SemiBold" />
                            <TextBlock x:Name="DetailText" Margin="12,0" Foreground="#5F6368" FontSize="12"
                                       Text="待命" />
                        </DockPanel>
                    </Grid>

                    <Grid Grid.Row="3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" BorderBrush="#D8DADF" BorderThickness="1" CornerRadius="8"
                                Background="White" Padding="2">
                            <ListBox x:Name="ResultList"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     FontFamily="Consolas, Cascadia Mono, Microsoft YaHei UI"
                                     FontSize="13"
                                     MouseDoubleClick="ResultList_OnMouseDoubleClick"
                                     VirtualizingPanel.IsVirtualizing="True">
                                <ListBox.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="复制选中" Click="CopySelected_OnClick" />
                                        <MenuItem Header="复制全部开放端口" Click="Copy_OnClick" />
                                    </ContextMenu>
                                </ListBox.ContextMenu>
                            </ListBox>
                        </Border>

                        <Border Grid.Column="2" BorderBrush="#D8DADF" BorderThickness="1" CornerRadius="8"
                                Background="White" Padding="2">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Text="活动日志" FontWeight="SemiBold"
                                           Margin="8,6,8,4" />
                                <ListBox x:Name="LogList"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         FontSize="11"
                                         Foreground="#5F6368"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
                            </DockPanel>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- 占用 / 释放 -->
            <TabItem Header="占用与释放">
                <Grid Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="White" BorderBrush="#D8DADF" BorderThickness="1"
                            CornerRadius="8" Padding="12" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="查询或结束占用指定端口的进程" FontWeight="SemiBold" Margin="0,0,0,8" />
                            <DockPanel>
                                <TextBlock Style="{StaticResource FieldLabel}" Text="端口" Width="40" />
                                <Button DockPanel.Dock="Right" Style="{StaticResource ActionBtn}" Content="结束占用"
                                        Margin="8,0,0,0" Click="KillPort_OnClick"
                                        ToolTip="强制结束占用该端口的进程（需权限）" />
                                <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryBtn}" Content="查询占用"
                                        Margin="8,0,0,0" Click="QueryPort_OnClick" />
                                <TextBox x:Name="OccupyPortBox" Style="{StaticResource FieldBox}" Text="10010"
                                         ToolTip="要查询或释放的本地端口号" />
                            </DockPanel>
                            <TextBlock Margin="0,8,0,0" FontSize="12" Foreground="#5F6368" TextWrapping="Wrap"
                                       Text="查询使用 netstat；结束占用会 taskkill 匹配到的 PID。请谨慎操作系统关键端口。" />
                        </StackPanel>
                    </Border>

                    <DockPanel Grid.Row="1" Margin="0,0,0,6">
                        <TextBlock Text="占用详情" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <Button DockPanel.Dock="Right" Style="{StaticResource ActionBtn}" Content="复制"
                                Margin="0" Click="CopyOccupy_OnClick" />
                    </DockPanel>

                    <Border Grid.Row="2" BorderBrush="#D8DADF" BorderThickness="1" CornerRadius="8"
                            Background="White" Padding="2">
                        <TextBox x:Name="OccupyResultBox"
                                 IsReadOnly="True"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto"
                                 BorderThickness="0"
                                 FontFamily="Consolas, Cascadia Mono, Microsoft YaHei UI"
                                 FontSize="12"
                                 Padding="8" />
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>

        <DockPanel Grid.Row="1" Margin="0,10,0,0">
            <TextBlock x:Name="StatusText" DockPanel.Dock="Left" VerticalAlignment="Center"
                       Foreground="#5F6368" FontSize="12" Text="就绪" />
            <Button DockPanel.Dock="Right" Style="{StaticResource ActionBtn}" Content="关闭"
                    Margin="0" Click="Close_OnClick" />
        </DockPanel>
    </Grid>
</Window>
