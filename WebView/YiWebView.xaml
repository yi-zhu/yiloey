<Window x:Class="holey.WebView.YiWebView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="hyperNet 自动化浏览器"
        Height="560" Width="960"
        MinHeight="320" MinWidth="560"
        Background="{Binding Path=Text, ElementName=BackgroundColorCombo}"
        Foreground="{Binding Path=Text, ElementName=ForegroundColorCombo}"
        FontFamily="Segoe UI, Microsoft YaHei UI"
        Loaded="Window_Loaded">
    <Window.Resources>
        <Style x:Key="ChromeButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Window}}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Margin" Value="1,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.75" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TabControl">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Window}}" />
            <Setter Property="Background" Value="{Binding Background, RelativeSource={RelativeSource AncestorType=Window}}" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,2,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Window}}"
                                BorderThickness="1,1,1,0"
                                Opacity="0.72"
                                MinWidth="100" MaxWidth="220" Height="30"
                                Margin="{TemplateBinding Margin}">
                            <ContentPresenter ContentSource="Header"
                                              Margin="8,0,6,0"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Stretch" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="1" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="0.9" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Background="{Binding Background, RelativeSource={RelativeSource AncestorType=Window}}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 工具栏：背景/前景跟随窗口配色 -->
        <Border Grid.Row="0"
                Background="{Binding Background, RelativeSource={RelativeSource AncestorType=Window}}"
                BorderBrush="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Window}}"
                BorderThickness="0,0,0,1"
                Padding="6,4"
                MouseLeftButtonDown="ToolBarTray_MouseLeftButtonDown">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="UiW" Style="{StaticResource ChromeButton}" Content="▮"
                            ToolTip="切换有无边框（立即生效）" Click="ToggleBorder_Click" />
                    <Button x:Name="BackBtn" Style="{StaticResource ChromeButton}" Content="←"
                            ToolTip="后退" Click="Back_Click" />
                    <Button x:Name="ForwardBtn" Style="{StaticResource ChromeButton}" Content="→"
                            ToolTip="前进" Click="Forward_Click" />
                    <Button x:Name="ReloadBtn" Style="{StaticResource ChromeButton}" Content="↻"
                            ToolTip="刷新" Click="Reload_Click" />
                    <Button Style="{StaticResource ChromeButton}" Content="新建" Click="NewTab_Click" />
                </StackPanel>

                <TextBox x:Name="AddressBox"
                         Grid.Column="1"
                         Margin="6,0"
                         Padding="8,4"
                         BorderThickness="0"
                         Background="Transparent"
                         Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Window}}"
                         CaretBrush="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Window}}"
                         VerticalContentAlignment="Center"
                         KeyDown="AddressBox_KeyDown"
                         ToolTip="输入网址后按回车跳转" />

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource ChromeButton}" Content="前往" Click="GoToAddress_Click" />
                    <Button x:Name="PinBtn" Style="{StaticResource ChromeButton}" Content="📌"
                            ToolTip="置顶" Click="TopItem_OnClick" />
                    <Button Style="{StaticResource ChromeButton}" Content="下载"
                            Click="DownloadWebpage_Click" ToolTip="下载当前网页及资源" />
                    <Button Style="{StaticResource ChromeButton}" Content="脚本"
                            Click="OpenScriptManager_Click" />
                    <ToggleButton x:Name="PageThemeToggle"
                                  Content="着色"
                                  Margin="2,0"
                                  Padding="8,4"
                                  Background="Transparent"
                                  BorderThickness="0"
                                  Cursor="Hand"
                                  Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Window}}"
                                  ToolTip="页面着色：把网页背景/前景同步成窗口配色"
                                  Checked="PageThemeToggle_Changed"
                                  Unchecked="PageThemeToggle_Changed" />

                    <TextBlock Text="背景" VerticalAlignment="Center" Margin="6,0,4,0"
                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Window}}" />
                    <ComboBox x:Name="BackgroundColorCombo"
                              IsEditable="True"
                              Width="78" Height="26"
                              BorderThickness="0"
                              VerticalContentAlignment="Center"
                              Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Window}}"
                              Background="{Binding Text, RelativeSource={RelativeSource Self}}"
                              TextBoxBase.TextChanged="BackgroundColorCombo_OnLostFocus">
                        <ComboBoxItem Background="#FFFFFF" Content="#FFFFFF" IsSelected="True" />
                        <ComboBoxItem Background="#000000" Content="#000000" />
                        <ComboBoxItem Background="#FF0000" Content="#FF0000" />
                        <ComboBoxItem Background="#00FF00" Content="#00FF00" />
                        <ComboBoxItem Background="#0000FF" Content="#0000FF" />
                        <ComboBoxItem Background="#FFFF00" Content="#FFFF00" />
                        <ComboBoxItem Background="#00FFFF" Content="#00FFFF" />
                        <ComboBoxItem Background="#FF00FF" Content="#FF00FF" />
                        <ComboBoxItem Background="#1E1E1E" Content="#1E1E1E" />
                        <ComboBoxItem Background="#FFF8E7" Content="#FFF8E7" />
                    </ComboBox>

                    <TextBlock Text="前景" VerticalAlignment="Center" Margin="6,0,4,0"
                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Window}}" />
                    <ComboBox x:Name="ForegroundColorCombo"
                              IsEditable="True"
                              Width="78" Height="26"
                              BorderThickness="0"
                              VerticalContentAlignment="Center"
                              Foreground="{Binding Text, RelativeSource={RelativeSource Self}}"
                              Background="Transparent"
                              TextBoxBase.TextChanged="ForegroundColorCombo_OnLostFocus">
                        <ComboBoxItem Foreground="#000000" Content="#000000" IsSelected="True" />
                        <ComboBoxItem Foreground="#FFFFFF" Content="#FFFFFF" />
                        <ComboBoxItem Foreground="#FF0000" Content="#FF0000" />
                        <ComboBoxItem Foreground="#00FF00" Content="#00FF00" />
                        <ComboBoxItem Foreground="#0000FF" Content="#0000FF" />
                        <ComboBoxItem Foreground="#FFFF00" Content="#FFFF00" />
                        <ComboBoxItem Foreground="#00FFFF" Content="#00FFFF" />
                        <ComboBoxItem Foreground="#FF00FF" Content="#FF00FF" />
                        <ComboBoxItem Foreground="#DAA520" Content="#DAA520" />
                    </ComboBox>
                </StackPanel>
            </Grid>
        </Border>

        <TabControl x:Name="TabControl"
                    Grid.Row="1"
                    Margin="0"
                    Background="{Binding Background, RelativeSource={RelativeSource AncestorType=Window}}"
                    Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Window}}"
                    SelectionChanged="TabControl_SelectionChanged" />

        <Border Grid.Row="2"
                Background="{Binding Background, RelativeSource={RelativeSource AncestorType=Window}}"
                BorderBrush="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Window}}"
                BorderThickness="0,1,0,0"
                Padding="8,3">
            <TextBlock x:Name="StatusText"
                       Text="就绪"
                       FontSize="11"
                       Opacity="0.8"
                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Window}}"
                       TextTrimming="CharacterEllipsis" />
        </Border>
    </Grid>
</Window>
