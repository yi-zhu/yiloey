<Window x:Class="holey.WebView.YiWebView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wpf="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="hyperNet 自动化浏览器" Height="450" Width="800"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:controls="clr-namespace:Windows.UI.Xaml.Controls;assembly=Windows.UI.Xaml"
        Background="{Binding Path=Text, ElementName=BackgroundColorCombo }"
        Foreground="{Binding Path=Text, ElementName=ForegroundColorCombo }"
        Loaded="Window_Loaded">
    <Window.Resources>
        <!-- 定义一个无边框、无填充、透明背景的 TabItem 样式 -->
        <Style x:Key="TransparentTabItemStyle" TargetType="TabItem">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Grid x:Name="templateRoot" SnapsToDevicePixels="true">
                            <!-- 这是标签头（Header）部分，如果你需要自定义可以在这里改 -->
                            <ContentPresenter x:Name="ContentPresenter" 
                                              ContentSource="Header" 
                                              HorizontalAlignment="{Binding HorizontalContentAlignment, RelativeSource={RelativeSource AncestorType=ItemsControl}}" 
                                              VerticalAlignment="{Binding VerticalContentAlignment, RelativeSource={RelativeSource AncestorType=ItemsControl}}" 
                                              RecognizesAccessKey="True"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <!-- 可以在这里添加选中状态等视觉反馈 -->
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <!-- 关键：将内容区域的背景设为透明 -->
            <Setter Property="Background" Value="Transparent" />
            <!-- 关键：移除内容区域的内边距 -->
            <Setter Property="Padding" Value="0" />
        </Style>

        <!-- 让 TabControl 使用这个新样式 -->
        <Style TargetType="TabControl">
            <Setter Property="ItemContainerStyle" Value="{StaticResource TransparentTabItemStyle}" />
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 顶部工具栏 -->
        <Viewbox HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <ToolBarTray Grid.Row="0" Margin="0" Background="Transparent" IsLocked="True"
                         MouseDown="ToolBarTray_MouseLeftButtonDown">

                <ToolBar Background="Transparent">
                    <Button Name="UiW" ToolTip="切换有无边框，窗口关闭再打开后才生效" Content="▮" Click="ToggleBorder_Click" />
                    <Button Content="新建" Click="NewTab_Click" Background="Transparent"
                            Foreground="{Binding Path=Text, ElementName=ForegroundColorCombo }" />
                    <TextBox x:Name="AddressBox" Width="300" Margin="5,0"
                             KeyDown="AddressBox_KeyDown"
                             BorderThickness="0"
                             Background="Transparent"
                             Foreground="{Binding Path=Text, ElementName=ForegroundColorCombo }"
                             ToolTip="输入网址后按回车跳转" />
                    <Button Content="前往" Click="GoToAddress_Click" Background="Transparent"
                            Foreground="{Binding Path=Text, ElementName=ForegroundColorCombo }" />
                    <Button Content="📌" ToolTip="置顶，将窗口桌面置于最上层" Click="TopItem_OnClick"></Button>
                    <Button Content="下载" 
                            Click="DownloadWebpage_Click" 
                            Background="Transparent"
                            Foreground="{Binding Path=Text, ElementName=ForegroundColorCombo }"
                            ToolTip="下载当前网页及所有资源到本地文件夹" />
                    <Separator Background="Transparent"
                               Foreground="{Binding Path=Text, ElementName=ForegroundColorCombo }" />
                    <Button Content="脚本" Click="OpenScriptManager_Click" Background="Transparent"
                            Foreground="{Binding Path=Text, ElementName=ForegroundColorCombo }" />
                    <!-- 颜色选择器区域 -->
                    <Separator Background="Transparent"
                               Foreground="{Binding Path=Text, ElementName=ForegroundColorCombo }" />
                    <!-- 背景色 -->
                    <TextBlock Text="背景:" VerticalAlignment="Center" Margin="0,0,5,0" Background="Transparent"
                               Foreground="{Binding Path=Text, ElementName=ForegroundColorCombo }" />
                    <ComboBox x:Name="BackgroundColorCombo"
                              TextBoxBase.TextChanged="BackgroundColorCombo_OnLostFocus"
                              IsEditable="True"
                              BorderThickness="0"
                              Width="70"
                              VerticalAlignment="Center"
                              Foreground="{Binding Path=Text, ElementName=ForegroundColorCombo }"
                              Background="{Binding Text ,RelativeSource={RelativeSource  Self}}"
                              Margin="0,0,20,0">
                        <ComboBoxItem Background="#FFFFFF" Content="#FFFFFF" IsSelected="True" />
                        <ComboBoxItem Background="#000000" Content="#000000" />
                        <ComboBoxItem Background="#FF0000" Content="#FF0000" />
                        <ComboBoxItem Background="#00FF00" Content="#00FF00" />
                        <ComboBoxItem Background="#0000FF" Content="#0000FF" />
                        <ComboBoxItem Background="#FFFF00" Content="#FFFF00" />
                        <ComboBoxItem Background="#00FFFF" Content="#00FFFF" />
                        <ComboBoxItem Background="#FF00FF" Content="#FF00FF" />
                    </ComboBox>

                    <!-- 前景色 -->
                    <TextBlock Text="前景:" VerticalAlignment="Center" Margin="0,0,5,0" Background="Transparent"
                               Foreground="{Binding Path=Text, ElementName=ForegroundColorCombo }" />
                    <ComboBox x:Name="ForegroundColorCombo"
                              IsEditable="True"
                              Width="70"
                              BorderThickness="0"
                              
                              TextBoxBase.TextChanged="ForegroundColorCombo_OnLostFocus"
                              Foreground="{Binding Text, RelativeSource={RelativeSource Self}  }"
                              Background="Transparent"
                              VerticalAlignment="Center">
                        <ComboBoxItem Foreground="#000000" Content="#000000" IsSelected="True" />
                        <ComboBoxItem Foreground="#FFFFFF" Content="#FFFFFF" />
                        <ComboBoxItem Foreground="#FF0000" Content="#FF0000" />
                        <ComboBoxItem Foreground="#00FF00" Content="#00FF00" />
                        <ComboBoxItem Foreground="#0000FF" Content="#0000FF" />
                        <ComboBoxItem Foreground="#FFFF00" Content="#FFFF00" />
                        <ComboBoxItem Foreground="#00FFFF" Content="#00FFFF" />
                        <ComboBoxItem Foreground="#FF00FF" Content="#FF00FF" />
                    </ComboBox>

                </ToolBar>
            </ToolBarTray>
        </Viewbox>
        <!-- 主区域：标签页 -->
       
        <!-- 主区域：标签页 -->
        <TabControl x:Name="TabControl" Grid.Row="1" Margin="0" BorderThickness="0" 
                    Background="{Binding Path=Text, ElementName=BackgroundColorCombo }"
                    Foreground="{Binding Path=Text, ElementName=ForegroundColorCombo }">
            <TabControl.Resources>
                <Style TargetType="TabItem">
                    <Setter Property="Margin" Value="0,0,0,0" />
                    <Setter Property="Padding" Value="0,0" />
                    <Setter Property="Background"
                            Value="{Binding Background, RelativeSource={RelativeSource AncestorType=TabControl}}" />
                    <Setter Property="Foreground"
                            Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabControl}}" />
                          <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Foreground}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter x:Name="Content"
                                              ContentSource="Header"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              SnapsToDevicePixels="True"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <!-- 选中状态：前景和背景取反 -->
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Opacity" Value="1"></Setter>
                                <Setter TargetName="Border" Property="Background"
                                        Value="{Binding Background, RelativeSource={RelativeSource AncestorType=TabControl}}"/>
                                <Setter Property="Foreground"
                                        Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabControl}}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="False">
                                <Setter TargetName="Border" Property="Background"
                                        Value="{Binding Background, RelativeSource={RelativeSource AncestorType=TabControl}}"/>
                                <Setter Property="Foreground"
                                        Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabControl}}"/>
                                <Setter Property="Opacity" Value="0.5"></Setter>
                            </Trigger>

                            <!-- 悬停效果 -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background"
                                        Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabControl}}"/>
                                <Setter Property="Foreground"
                                        Value="{Binding Background, RelativeSource={RelativeSource AncestorType=TabControl}}"/>
                                <Setter Property="Opacity" Value="0.5"></Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
                </Style>
            </TabControl.Resources>
        </TabControl>
        <Grid  Grid.Row="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" >
                <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch" >
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"></ColumnDefinition>
                        <ColumnDefinition Width="*"></ColumnDefinition>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"></RowDefinition>
                        <RowDefinition Height="*"></RowDefinition>
                    </Grid.RowDefinitions>
                  <Viewbox Grid.Row="1" Grid.Column="1">
                      <TextBlock Name="WuPinTola" Grid.Row="1" Grid.Column="1" Background="{Binding Path=Text, ElementName=BackgroundColorCombo }"
                                 Foreground="{Binding Path=Text, ElementName=ForegroundColorCombo }" TextWrapping="Wrap" >
                      </TextBlock>
                  </Viewbox>    
                </Grid>
        </Grid>
        
    </Grid>


</Window>